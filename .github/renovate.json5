{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>peacock0803sz/renovate-config"],
  "nix": {
    "enabled": true,
  },
  "lockFileMaintenance": {
    "enabled": true,
    "minimumReleaseAge": null,
    "commitMessagePrefix": ":snowflake:",
    "commitMessageAction": "Update",
    "commitMessageTopic": "flake.lock",
    "commitMessageExtra": "",
  },
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "groupName": "nix flake inputs",
      "commitMessagePrefix": ":snowflake:",
      "commitMessageAction": "Update",
      "commitMessageTopic": "flake.lock",
      "commitMessageExtra": "",
      "group": {
        "commitMessageTopic": "flake.lock",
        "commitMessageExtra": "",
      },
    },
  ],
}
