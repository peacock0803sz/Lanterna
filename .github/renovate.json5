{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>peacock0803sz/renovate-config"],
  "nix": {
    "enabled": true,
  },
  "lockFileMaintenance": {
    "enabled": true,
  },
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "groupName": "nix flake inputs",
    },
  ],
}
