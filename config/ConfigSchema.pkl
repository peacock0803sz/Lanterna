// Schema for Lanterna's config file (config.json).
//
// Source of truth for shape and defaults. Validation lives in Swift
// (AppConfiguration.swift), which mirrors the rules below.
// Regenerate the JSON Schema and the snapshot when this changes:
// scripts/regenerate-config.sh.
module lanterna.Config

/// A lower bound declared for one integer key.
///
/// Read by config/GenJsonSchema.pkl and mirrored by the Swift validation.
/// Keeping the bound here makes the schema document derive it.
open class Minimum extends Annotation {
  value: Int
}

/// Upper bound annotation for integer keys, read the same way.
open class Maximum extends Annotation {
  value: Int
}

/// Schema generation. Stays 1 for this revision.
version: Int = 1

/// The allowed string values declared for one key.
///
/// Read by config/GenJsonSchema.pkl and mirrored by the Swift validation.
open class Allowed extends Annotation {
  values: Listing<String>
}

/// How one special window kind is shown: mixed in, hidden, or parked below.
typealias DisplayMode = "show"|"hide"|"separateAtBottom"

/// Which appearance the windows follow: the system, or a fixed one.
typealias AppearanceMode = "system"|"light"|"dark"

/// The appearance the panel and the guide windows use. Absent means "system".
@Allowed { values { "system" "light" "dark" } }
appearanceMode: AppearanceMode? = null

/// Which readings the romaji filter matches: kana only, or kana plus kanji readings.
typealias RomajiScope = "kana"|"kanji"

/// The scope the romaji filter matches in. Absent means "kanji".
@Allowed { values { "kana" "kanji" } }
romajiScope: RomajiScope? = null

/// How many characters of a query the shortcut memory covers: a longer
/// query is neither recorded nor applied. 0 means off. Absent means 5.
/// Values above 5 invalidate the whole file (mirrored by the Swift
/// validation, which also enforces the upper bound).
@Minimum { value = 0 }
shortcutMemoryLength: Int? = null

/// Whether the filter also matches subsequence queries, not only
/// substrings. Absent means on.
fuzzyMatchEnabled: Boolean? = null

/// The order the narrowed rows draw in: recent use first, or best match
/// first.
typealias ResultOrder = "mru"|"score"

/// The order the narrowed rows draw in. Absent means "mru".
@Allowed { values { "mru" "score" } }
resultOrder: ResultOrder? = null

/// Windows on other Spaces. Absent means "show".
@Allowed { values { "show" "hide" "separateAtBottom" } }
otherSpaceMode: DisplayMode? = null

/// Windows of hidden applications. Absent means "separateAtBottom".
@Allowed { values { "show" "hide" "separateAtBottom" } }
hiddenAppMode: DisplayMode? = null

/// Minimized windows. Absent means "separateAtBottom".
@Allowed { values { "show" "hide" "separateAtBottom" } }
minimizedMode: DisplayMode? = null

/// Native fullscreen windows. Absent means "show".
@Allowed { values { "show" "hide" "separateAtBottom" } }
fullscreenMode: DisplayMode? = null

/// Running applications with no open window, each listed as a row of its
/// own. Absent means "hide".
@Allowed { values { "show" "hide" "separateAtBottom" } }
windowlessAppMode: DisplayMode? = null

/// Fixture entries to show instead of live windows.
/// Absent means live windows. Must be zero or more when present.
@Minimum { value = 0 }
sampleCount: Int? = null

/// Intentional monitor stops, in whole seconds, so recovery can be watched.
/// Absent means an ordinary run. Must be one or more when present.
@Minimum { value = 1 }
stopMonitorEvery: Int? = null

/// Whether Lanterna starts at login. Absent means off.
launchAtLogin: Boolean? = null

/// Deprecated; ignored. Every level is recorded now, and the log window
/// filters what it shows. Any value is accepted so older files keep
/// their other settings.
logLevel: Any? = null

/// Whether each launch's log lines are kept on disk, so an earlier
/// launch can be read after a restart. Absent means on.
saveLogsToDisk: Boolean? = null

/// Whether Lanterna checks for newer releases. Absent means off.
updateCheckEnabled: Boolean? = null

/// Whether hovering a row moves the selection. Absent means off.
hoverSelect: Boolean? = null

/// Whether scrolling moves the selection. Absent means off.
scrollSelect: Boolean? = null

/// Whether holding Command or Option and pressing a row number jumps to
/// that row. Absent means off.
numberJump: Boolean? = null

/// Whether moving the selected row by key works in grouped lists.
/// Absent means off.
numberReorder: Boolean? = null

/// Which rows row numbers cover: only window rows, or every row.
typealias NumberScope = "windows"|"allRows"

/// The rows row numbers cover. Absent means "windows".
@Allowed { values { "windows" "allRows" } }
numberScope: NumberScope? = null

/// How the left edge of each row reads: prefix hints, row numbers,
/// or no hint frame.
typealias HintsMode = "prefix"|"numbers"|"neither"

/// How the left edge of each row reads. Absent means "prefix".
@Allowed { values { "prefix" "numbers" "neither" } }
hintsMode: HintsMode? = null

/// One group's hand-arranged row order.
open class RowOrderEntry {
  /// The manual group number, 1 to 9.
  group: Int
  /// Row keys in order: bundle identifier, then the window title.
  keys: Listing<String>
}

/// Hand-arranged row orders by manual group. Entries that are invalid on
/// their own are ignored one by one. Absent means no overrides.
rowOrder: Listing<RowOrderEntry>? = null

/// Which releases the check covers: full releases only, or prereleases too.
typealias UpdateChannel = "stable"|"beta"

/// The releases the check covers. Absent means "stable".
@Allowed { values { "stable" "beta" } }
updateChannel: UpdateChannel? = null

/// One entry of the exclusion list: which app and which titles to hide.
open class ExclusionEntry {
  /// A bundle identifier for exact matching, or a regular expression
  /// matched against the display name. Empty means invalid.
  app: String
  /// A substring, or an exact title when wrapped as `^...$`. Empty means invalid.
  titlePattern: String
}

/// Windows to keep out of the switcher list. Absent means no exclusions.
/// Elements that are invalid on their own are ignored one by one.
exclusions: Listing<ExclusionEntry>? = null

/// One modifier key held with a key binding.
typealias KeyModifier = "cmd"|"ctrl"|"opt"|"shift"

/// One physical key assignment: where the key sits plus the modifiers held
/// with it. Input-source independent: the code names a position, not a character.
open class KeyBinding {
  /// The physical key, in the same numbering `PanelKeystroke.keyCode` carries.
  keyCode: Int
  /// The modifiers held with it. Empty means the bare key.
  modifiers: Listing<KeyModifier>
}

/// The per-action key lists. Absent actions keep their defaults.
/// Entries that are invalid on their own are ignored one by one,
/// falling back to the default for that action.
open class KeyBindings {
  show: Listing<KeyBinding>? = null
  showReverse: Listing<KeyBinding>? = null
  showFilter: Listing<KeyBinding>? = null
  next: Listing<KeyBinding>? = null
  previous: Listing<KeyBinding>? = null
  commit: Listing<KeyBinding>? = null
  cancel: Listing<KeyBinding>? = null
  toggleScope: Listing<KeyBinding>? = null
  deleteBackward: Listing<KeyBinding>? = null
  clearQuery: Listing<KeyBinding>? = null
  closeWindow: Listing<KeyBinding>? = null
  quitApplication: Listing<KeyBinding>? = null
  hideApplication: Listing<KeyBinding>? = null
  minimizeWindow: Listing<KeyBinding>? = null
}

/// User-configurable keybindings. Absent means all defaults.
keybindings: KeyBindings? = null

/// The panel text and icon scale as a multiplier: one of the five steps.
/// Absent means 1.0 (the current size). The value allowlist lives in
/// Swift, like the upper bound of `shortcutMemoryLength`.
textScale: Number? = null

/// The panel width as a multiplier over the text-scaled width: one of
/// the allowed steps. Absent means 1.0 (the text-scaled width
/// unchanged). The value allowlist lives in Swift, like `textScale`.
panelWidth: Number? = null

/// The panel show delay in milliseconds before the panel appears.
/// Absent or zero means off. Past 1000 clamps to it with a note, and
/// anything else unreadable falls back to 150 with a note. The bounds
/// live in Swift, like `panelWidth`.
showDelayMs: Number? = null

/// Which applications' windows each showing starts on.
typealias WindowScope = "allApps"|"frontApp"

/// Every application's windows, or only those of the application in
/// front when the panel opens. Absent means "allApps".
@Allowed { values { "allApps" "frontApp" } }
windowScope: WindowScope? = null

/// Which display the panel opens on: the menu-bar display, the one
/// under the cursor, the one holding the focused window, or every
/// display at once. Absent means "primary".
typealias DisplayTarget = "primary"|"cursor"|"frontWindow"|"all"

/// The menu-bar display, the cursor's display, the focused window's
/// display, or every display. Absent means "primary".
@Allowed { values { "primary" "cursor" "frontWindow" "all" } }
displayTarget: DisplayTarget? = null

/// How the switcher list groups its rows.
typealias GroupingMode = "none"|"bySpace"|"manual"

/// One list, one group per Space with the shown Spaces first, or groups
/// made by assigning applications. Absent means "none".
@Allowed { values { "none" "bySpace" "manual" } }
grouping: GroupingMode? = null

/// Where one kind's parked section goes once the list is grouped.
typealias SubgroupPlacement = "endOfList"|"withinGroup"

/// Where the windows-on-other-spaces section goes when grouped. Absent means "endOfList".
/// Ignored when grouping by Space, which puts those windows in their own Space's group.
@Allowed { values { "endOfList" "withinGroup" } }
otherSpacePlacement: SubgroupPlacement? = null

/// Where the hidden-apps section goes when grouped. Absent means "endOfList".
@Allowed { values { "endOfList" "withinGroup" } }
hiddenAppPlacement: SubgroupPlacement? = null

/// Where the minimized section goes when grouped. Absent means "endOfList".
@Allowed { values { "endOfList" "withinGroup" } }
minimizedPlacement: SubgroupPlacement? = null

/// Where the fullscreen section goes when grouped. Absent means "endOfList".
@Allowed { values { "endOfList" "withinGroup" } }
fullscreenPlacement: SubgroupPlacement? = null

/// Where the apps-without-windows section goes when grouped. Absent means "endOfList".
/// Grouping by Space always puts it after the last group, since those apps are on no Space.
@Allowed { values { "endOfList" "withinGroup" } }
windowlessAppPlacement: SubgroupPlacement? = null

/// How many manual groups there are, 1 to 9. Absent means 1.
@Minimum { value = 1 }
@Maximum { value = 9 }
groupCount: Int? = null

/// What a manual group heading says.
typealias GroupHeadingStyle = "number"|"name"|"appNames"

/// The group number, the name given to the group, or the names of the
/// apps in it. Absent means "number".
@Allowed { values { "number" "name" "appNames" } }
groupHeadingStyle: GroupHeadingStyle? = null

/// The names given to manual groups, keyed "1" to "9". Names for groups
/// past the count are kept. Absent means no names.
groupNames: Mapping<String, String>? = null

/// One application assigned to one manual group.
open class GroupAssignment {
  /// The application's bundle identifier, compared without case.
  bundleID: String
  /// The group number, 1 to 9.
  group: Int
}

/// Applications assigned to manual groups. Entries that are invalid on
/// their own, or name an application an earlier entry named, are ignored
/// one by one. Absent means every application joins the first group.
groupAssignments: Listing<GroupAssignment>? = null
