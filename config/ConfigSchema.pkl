// Schema for Lanterna's config file (config.json).
//
// Source of truth for shape and defaults. Validation lives in Swift
// (AppConfiguration.swift), which mirrors the rules below.
// Regenerate the JSON Schema and the snapshot when this changes:
// scripts/regenerate-config.sh.
module lanterna.Config

/// A lower bound declared for one integer key.
///
/// Read by config/GenJsonSchema.pkl and mirrored by the Swift validation.
/// Keeping the bound here makes the schema document derive it.
open class Minimum extends Annotation {
  value: Int
}

/// Schema generation. Stays 1 for this revision.
version: Int = 1

/// The allowed string values declared for one key.
///
/// Read by config/GenJsonSchema.pkl and mirrored by the Swift validation.
open class Allowed extends Annotation {
  values: Listing<String>
}

/// How one special window kind is shown: mixed in, hidden, or parked below.
typealias DisplayMode = "show"|"hide"|"separateAtBottom"

/// Which appearance the windows follow: the system, or a fixed one.
typealias AppearanceMode = "system"|"light"|"dark"

/// The appearance the panel and the guide windows use. Absent means "system".
@Allowed { values { "system" "light" "dark" } }
appearanceMode: AppearanceMode? = null

/// Which readings the romaji filter matches: kana only, or kana plus kanji readings.
typealias RomajiScope = "kana"|"kanji"

/// The scope the romaji filter matches in. Absent means "kanji".
@Allowed { values { "kana" "kanji" } }
romajiScope: RomajiScope? = null

/// How many characters of a query the shortcut memory covers: a longer
/// query is neither recorded nor applied. 0 means off. Absent means 5.
/// Values above 5 invalidate the whole file (mirrored by the Swift
/// validation, which also enforces the upper bound).
@Minimum { value = 0 }
shortcutMemoryLength: Int? = null

/// Whether the filter also matches subsequence queries, not only
/// substrings. Absent means on.
fuzzyMatchEnabled: Boolean? = null

/// The order the narrowed rows draw in: recent use first, or best match
/// first.
typealias ResultOrder = "mru"|"score"

/// The order the narrowed rows draw in. Absent means "mru".
@Allowed { values { "mru" "score" } }
resultOrder: ResultOrder? = null

/// Windows on other Spaces. Absent means "show".
@Allowed { values { "show" "hide" "separateAtBottom" } }
otherSpaceMode: DisplayMode? = null

/// Windows of hidden applications. Absent means "separateAtBottom".
@Allowed { values { "show" "hide" "separateAtBottom" } }
hiddenAppMode: DisplayMode? = null

/// Minimized windows. Absent means "separateAtBottom".
@Allowed { values { "show" "hide" "separateAtBottom" } }
minimizedMode: DisplayMode? = null

/// Native fullscreen windows. Absent means "show".
@Allowed { values { "show" "hide" "separateAtBottom" } }
fullscreenMode: DisplayMode? = null

/// Fixture entries to show instead of live windows.
/// Absent means live windows. Must be zero or more when present.
@Minimum { value = 0 }
sampleCount: Int? = null

/// Intentional monitor stops, in whole seconds, so recovery can be watched.
/// Absent means an ordinary run. Must be one or more when present.
@Minimum { value = 1 }
stopMonitorEvery: Int? = null

/// Whether Lanterna starts at login. Absent means off.
launchAtLogin: Boolean? = null

/// How much diagnostics to emit: errors only, warnings and above, or
/// down through info and debug. Absent means "warning".
typealias LogLevel = "error"|"warning"|"info"|"debug"

/// The diagnostics threshold. Absent means "warning".
@Allowed { values { "error" "warning" "info" "debug" } }
logLevel: LogLevel? = null

/// Whether Lanterna checks for newer releases. Absent means off.
updateCheckEnabled: Boolean? = null

/// Which releases the check covers: full releases only, or prereleases too.
typealias UpdateChannel = "stable"|"beta"

/// The releases the check covers. Absent means "stable".
@Allowed { values { "stable" "beta" } }
updateChannel: UpdateChannel? = null

/// One entry of the exclusion list: which app and which titles to hide.
open class ExclusionEntry {
  /// A bundle identifier for exact matching, or a regular expression
  /// matched against the display name. Empty means invalid.
  app: String
  /// A substring, or an exact title when wrapped as `^...$`. Empty means invalid.
  titlePattern: String
}

/// Windows to keep out of the switcher list. Absent means no exclusions.
/// Elements that are invalid on their own are ignored one by one.
exclusions: Listing<ExclusionEntry>? = null

/// One modifier key held with a key binding.
typealias KeyModifier = "cmd"|"ctrl"|"opt"|"shift"

/// One physical key assignment: where the key sits plus the modifiers held
/// with it. Input-source independent: the code names a position, not a character.
open class KeyBinding {
  /// The physical key, in the same numbering `PanelKeystroke.keyCode` carries.
  keyCode: Int
  /// The modifiers held with it. Empty means the bare key.
  modifiers: Listing<KeyModifier>
}

/// The per-action key lists. Absent actions keep their defaults.
/// Entries that are invalid on their own are ignored one by one,
/// falling back to the default for that action.
open class KeyBindings {
  show: Listing<KeyBinding>? = null
  showReverse: Listing<KeyBinding>? = null
  showFilter: Listing<KeyBinding>? = null
  next: Listing<KeyBinding>? = null
  previous: Listing<KeyBinding>? = null
  commit: Listing<KeyBinding>? = null
  cancel: Listing<KeyBinding>? = null
  deleteBackward: Listing<KeyBinding>? = null
  clearQuery: Listing<KeyBinding>? = null
  closeWindow: Listing<KeyBinding>? = null
  quitApplication: Listing<KeyBinding>? = null
  hideApplication: Listing<KeyBinding>? = null
  minimizeWindow: Listing<KeyBinding>? = null
}

/// User-configurable keybindings. Absent means all defaults.
keybindings: KeyBindings? = null

/// The panel text and icon scale as a multiplier: one of the five steps.
/// Absent means 1.0 (the current size). The value allowlist lives in
/// Swift, like the upper bound of `shortcutMemoryLength`.
textScale: Number? = null
