// Generates config/config-schema.json from ConfigSchema.pkl.
//
// Run scripts/regenerate-config.sh to refresh the document. Do not edit the
// output by hand; change the schema and regenerate instead.
import "pkl:reflect"
import "ConfigSchema.pkl" as schema

local props = reflect.Module(schema).moduleClass.properties

local function minimumOf(prop: reflect.Property): Int? =
  prop.annotations.filter((it) -> it is schema.Minimum).firstOrNull?.value

local function allowedOf(prop: reflect.Property): Listing<String>? =
  prop.annotations.filter((it) -> it is schema.Allowed).firstOrNull?.values

/// Whether the property holds a boolean, nullable or not.
///
/// Reads the declared type through reflect: a nullable type unwraps one
/// level through `member`, and the referent names the stdlib class.
local function isBoolean(prop: reflect.Property): Boolean =
  if (prop.type is reflect.NullableType)
    let (inner = (prop.type as reflect.NullableType).member)
    inner is reflect.DeclaredType
      && (inner as reflect.DeclaredType).referent.name == "Boolean"
  else
    prop.type is reflect.DeclaredType
      && (prop.type as reflect.DeclaredType).referent.name == "Boolean"

local function fragment(prop: reflect.Property): Dynamic =
  if (allowedOf(prop) != null)
    new {
      ["type"] = "string"
      ["enum"] = allowedOf(prop)
      description = prop.docComment
    }
  else if (isBoolean(prop))
    new {
      ["type"] = "boolean"
      description = prop.docComment
    }
  else if (minimumOf(prop) == null)
    new {
      ["type"] = "integer"
      description = prop.docComment
    }
  else
    new {
      ["type"] = "integer"
      description = prop.docComment
      ["minimum"] = minimumOf(prop)
    }

`$schema` = "https://json-schema.org/draft/2020-12/schema"
`$comment` = "Generated from ConfigSchema.pkl. Do not edit by hand."
title = "Lanterna config"
description = "Settings vessel for Lanterna. Strict: unknown keys invalidate the whole file."
type = "object"
properties = new {
  for (name, prop in props) {
    [name] = fragment(prop)
  }
}
additionalProperties = false
