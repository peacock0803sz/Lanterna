// Generates config/config-schema.json from ConfigSchema.pkl.
//
// Run scripts/regenerate-config.sh to refresh the document. Do not edit the
// output by hand; change the schema and regenerate instead.
import "pkl:reflect"
import "ConfigSchema.pkl" as schema

local props = reflect.Module(schema).moduleClass.properties

local function minimumOf(prop: reflect.Property): Int? =
  prop.annotations.filter((it) -> it is schema.Minimum).firstOrNull?.value

local function maximumOf(prop: reflect.Property): Int? =
  prop.annotations.filter((it) -> it is schema.Maximum).firstOrNull?.value

local function allowedOf(prop: reflect.Property): Listing<String>? =
  prop.annotations.filter((it) -> it is schema.Allowed).firstOrNull?.values

/// Whether the property holds a boolean, nullable or not.
///
/// Reads the declared type through reflect: a nullable type unwraps one
/// level through `member`, and the referent names the stdlib class.
local function isBoolean(prop: reflect.Property): Boolean =
  if (prop.type is reflect.NullableType)
    let (inner = (prop.type as reflect.NullableType).member)
    inner is reflect.DeclaredType
      && (inner as reflect.DeclaredType).referent.name == "Boolean"
  else
    prop.type is reflect.DeclaredType
      && (prop.type as reflect.DeclaredType).referent.name == "Boolean"

/// Whether the property is the exclusion list.
///
/// Matched by name, since several keys hold listings with different item
/// shapes.
local function isExclusions(prop: reflect.Property): Boolean = prop.name == "exclusions"

/// Whether the property is the group assignment list.
local function isGroupAssignments(prop: reflect.Property): Boolean = prop.name == "groupAssignments"

/// Whether the property is the group name table.
local function isGroupNames(prop: reflect.Property): Boolean = prop.name == "groupNames"

/// Whether the property is the forced input source, the one free-form
/// string key.
local function isForcedInputSource(prop: reflect.Property): Boolean = prop.name == "forcedInputSource"

/// Whether the property is the keybindings section (a nullable class).
///
/// Matched by shape rather than by name, so a rename still renders.
local function isKeyBindings(prop: reflect.Property): Boolean =
  if (prop.type is reflect.NullableType)
    let (inner = (prop.type as reflect.NullableType).member)
    inner is reflect.DeclaredType
      && (inner as reflect.DeclaredType).referent.name == "KeyBindings"
  else false

/// Whether the property is the switchers section (a nullable class).
///
/// Matched by shape rather than by name, so a rename still renders.
local function isSwitchers(prop: reflect.Property): Boolean =
  if (prop.type is reflect.NullableType)
    let (inner = (prop.type as reflect.NullableType).member)
    inner is reflect.DeclaredType
      && (inner as reflect.DeclaredType).referent.name == "Switchers"
  else false

/// One parallel-switcher value beside its "inherit" escape hatch: the
/// value reads as usual, and "inherit" follows the main switcher.
local function inheritWrapper(inner: Dynamic, doc: String): Dynamic = new {
  description = doc
  ["oneOf"] = new Listing<Dynamic> {
    inner
    new { ["const"] = "inherit" }
  }
}

/// The keys both switchers share, spelled out by hand like the keybinding
/// actions above. A new top-level key lands here when it is shared, and
/// the schema parity test holds the list to `knownKeys`.
local sharedSwitcherKeys = new Listing<String> {
  "appearanceMode"; "romajiScope"; "forcedInputSource"; "launchAtLogin"; "logLevel";
  "saveLogsToDisk"; "updateCheckEnabled"; "updateChannel"; "exclusions";
  "shortcutMemoryLength"; "keybindings"; "sampleCount"; "stopMonitorEvery";
  "rowOrder"; "groupNames"; "groupAssignments"; "resultOrder"; "grouping";
  "groupCount"; "groupHeadingStyle"; "displayTarget"; "panelWidth"; "panelRows";
  "textScale"; "showDelayMs"; "hintsMode"; "numberJump"; "numberReorder"; "numberScope";
  "hoverSelect"; "scrollSelect"; "autoFocusSingleCandidate"; "fuzzyMatchEnabled";
  "listWindowsOnAllSpaces"
}

/// The two switcher sections side by side. The main section renders each
/// key as usual; the parallel section wraps each panel key in the
/// "inherit" escape hatch, while its switch and the shared keys render
/// as usual (the shared ones staying description-only, as at top level).
local function switchersFragment(prop: reflect.Property): Dynamic = new {
  ["type"] = "object"
  description = prop.docComment
  ["properties"] = new {
    ["main"] = new {
      ["type"] = "object"
      description = "The main switcher's list settings."
      ["properties"] = new {
        for (name, sub in reflect.Module(schema).classes["SwitcherMain"].properties) {
          [name] = fragment(sub)
        }
      }
      ["additionalProperties"] = false
    }
    ["parallel"] = new {
      ["type"] = "object"
      description = "The parallel switcher's list settings."
      ["properties"] = new {
        for (name, sub in reflect.Module(schema).classes["SwitcherParallel"].properties) {
          [name] =
            if (name == "enabled" || sharedSwitcherKeys.contains(name)) fragment(sub)
            else inheritWrapper(fragment(sub), sub.docComment)
        }
      }
      ["additionalProperties"] = false
    }
  }
  ["additionalProperties"] = false
}

/// Whether the property holds a number, nullable or not.
///
/// Matched by shape rather than by name, so a rename still renders.
local function isNumber(prop: reflect.Property): Boolean =
  if (prop.type is reflect.NullableType)
    let (inner = (prop.type as reflect.NullableType).member)
    inner is reflect.DeclaredType
      && (inner as reflect.DeclaredType).referent.name == "Number"
  else
    prop.type is reflect.DeclaredType
      && (prop.type as reflect.DeclaredType).referent.name == "Number"

/// One keybinding entry: a physical key code plus modifier words.
local keyBindingItem: Dynamic = new {
  ["type"] = "object"
  ["properties"] = new {
    ["keyCode"] = new {
      ["type"] = "integer"
    }
    ["modifiers"] = new {
      ["type"] = "array"
      ["items"] = new {
        ["type"] = "string"
        ["enum"] = new Listing<String> { "cmd"; "ctrl"; "opt"; "shift" }
      }
    }
  }
  ["required"] = new Listing<String> { "keyCode"; "modifiers" }
  ["additionalProperties"] = false
}

/// The per-action key lists, one array per action. Absent actions keep
/// their defaults; the fallback rules live in Swift, not here.
local function keyBindingsFragment(prop: reflect.Property): Dynamic = new {
  ["type"] = "object"
  description = prop.docComment
  ["properties"] = new {
    for (action in new Listing<String> {
      "show"; "showReverse"; "showFilter"; "next"; "previous";
      "commit"; "cancel"; "toggleScope"; "deleteBackward"; "clearQuery";
      "closeWindow"; "quitApplication"; "hideApplication"; "minimizeWindow";
      "numberJump"; "moveRowUp"; "moveRowDown";
      "startFiltering"; "openSettings";
      "moveCursorLeft"; "moveCursorRight"; "moveCursorToStart"; "moveCursorToEnd";
      "deleteForward"; "deleteWordBackward"; "deleteToStart"; "deleteToEnd";
      "showParallel"; "showParallelReverse"
    }) {
      [action] = new {
        ["type"] = "array"
        ["items"] = keyBindingItem
      }
    }
  }
  ["additionalProperties"] = false
}

/// Whether the property takes any value: a retired key, kept only so
/// older files stay valid.
local function isAny(prop: reflect.Property): Boolean =
  if (prop.type is reflect.NullableType)
    let (inner = (prop.type as reflect.NullableType).member)
    inner is reflect.DeclaredType
      && (inner as reflect.DeclaredType).referent.name == "Any"
  else false

local function fragment(prop: reflect.Property): Dynamic =
  if (isAny(prop))
    new {
      description = prop.docComment
      ["deprecated"] = true
    }
  else if (allowedOf(prop) != null)
    new {
      ["type"] = "string"
      ["enum"] = allowedOf(prop)
      description = prop.docComment
    }
  else if (isBoolean(prop))
    new {
      ["type"] = "boolean"
      description = prop.docComment
    }
  else if (isExclusions(prop))
    new {
      ["type"] = "array"
      description = prop.docComment
      ["items"] = new {
        ["type"] = "object"
        ["properties"] = new {
          ["app"] = new {
            ["type"] = "string"
          }
          ["titlePattern"] = new {
            ["type"] = "string"
          }
        }
        ["required"] = new Listing<String> { "app"; "titlePattern" }
        ["additionalProperties"] = false
      }
    }
  else if (isGroupAssignments(prop))
    new {
      ["type"] = "array"
      description = prop.docComment
      ["items"] = new {
        ["type"] = "object"
        ["properties"] = new {
          ["bundleID"] = new {
            ["type"] = "string"
          }
          ["group"] = new {
            ["type"] = "integer"
            ["minimum"] = 1
            ["maximum"] = 9
          }
        }
        ["required"] = new Listing<String> { "bundleID"; "group" }
        ["additionalProperties"] = false
      }
    }
  else if (isGroupNames(prop))
    new {
      ["type"] = "object"
      description = prop.docComment
      ["patternProperties"] = new {
        ["^[1-9]$"] = new {
          ["type"] = "string"
        }
      }
      ["additionalProperties"] = false
    }
  else if (isForcedInputSource(prop))
    new {
      ["type"] = "string"
      description = prop.docComment
      ["minLength"] = 1
    }
  else if (isKeyBindings(prop))
    keyBindingsFragment(prop)
  else if (isSwitchers(prop))
    switchersFragment(prop)
  else if (isNumber(prop))
    new {
      ["type"] = "number"
      description = prop.docComment
    }
  else if (minimumOf(prop) == null)
    new {
      ["type"] = "integer"
      description = prop.docComment
    }
  else if (maximumOf(prop) == null)
    new {
      ["type"] = "integer"
      description = prop.docComment
      ["minimum"] = minimumOf(prop)
    }
  else
    new {
      ["type"] = "integer"
      description = prop.docComment
      ["minimum"] = minimumOf(prop)
      ["maximum"] = maximumOf(prop)
    }

`$schema` = "https://json-schema.org/draft/2020-12/schema"
`$comment` = "Generated from ConfigSchema.pkl. Do not edit by hand."
title = "Lanterna config"
description = "Settings vessel for Lanterna. Strict: unknown keys invalidate the whole file."
type = "object"
properties = new {
  for (name, prop in props) {
    [name] = fragment(prop)
  }
}
additionalProperties = false
