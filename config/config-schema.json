{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from ConfigSchema.pkl. Do not edit by hand.",
  "title": "Lanterna config",
  "description": "Settings vessel for Lanterna. Strict: unknown keys invalidate the whole file.",
  "type": "object",
  "properties": {
    "version": {
      "description": "Schema generation. Stays 1 for this revision.",
      "type": "integer"
    },
    "appearanceMode": {
      "description": "The appearance the panel and the guide windows use. Absent means \"system\".",
      "type": "string",
      "enum": [
        "system",
        "light",
        "dark"
      ]
    },
    "romajiScope": {
      "description": "The scope the romaji filter matches in. Absent means \"kanji\".",
      "type": "string",
      "enum": [
        "kana",
        "kanji"
      ]
    },
    "shortcutMemoryLength": {
      "description": "How many characters of a query the shortcut memory covers: a longer\nquery is neither recorded nor applied. 0 means off. Absent means 5.\nValues above 5 invalidate the whole file (mirrored by the Swift\nvalidation, which also enforces the upper bound).",
      "type": "integer",
      "minimum": 0
    },
    "fuzzyMatchEnabled": {
      "description": "Whether the filter also matches subsequence queries, not only\nsubstrings. Absent means on.",
      "type": "boolean"
    },
    "resultOrder": {
      "description": "The order the narrowed rows draw in. Absent means \"mru\".",
      "type": "string",
      "enum": [
        "mru",
        "score"
      ]
    },
    "otherSpaceMode": {
      "description": "Windows on other Spaces. Absent means \"show\".",
      "type": "string",
      "enum": [
        "show",
        "hide",
        "separateAtBottom"
      ]
    },
    "hiddenAppMode": {
      "description": "Windows of hidden applications. Absent means \"separateAtBottom\".",
      "type": "string",
      "enum": [
        "show",
        "hide",
        "separateAtBottom"
      ]
    },
    "minimizedMode": {
      "description": "Minimized windows. Absent means \"separateAtBottom\".",
      "type": "string",
      "enum": [
        "show",
        "hide",
        "separateAtBottom"
      ]
    },
    "fullscreenMode": {
      "description": "Native fullscreen windows. Absent means \"show\".",
      "type": "string",
      "enum": [
        "show",
        "hide",
        "separateAtBottom"
      ]
    },
    "windowlessAppMode": {
      "description": "Running applications with no open window, each listed as a row of its\nown. Absent means \"hide\".",
      "type": "string",
      "enum": [
        "show",
        "hide",
        "separateAtBottom"
      ]
    },
    "sampleCount": {
      "description": "Fixture entries to show instead of live windows.\nAbsent means live windows. Must be zero or more when present.",
      "type": "integer",
      "minimum": 0
    },
    "stopMonitorEvery": {
      "description": "Intentional monitor stops, in whole seconds, so recovery can be watched.\nAbsent means an ordinary run. Must be one or more when present.",
      "type": "integer",
      "minimum": 1
    },
    "launchAtLogin": {
      "description": "Whether Lanterna starts at login. Absent means off.",
      "type": "boolean"
    },
    "logLevel": {
      "description": "Deprecated; ignored. Every level is recorded now, and the log window\nfilters what it shows. Any value is accepted so older files keep\ntheir other settings.",
      "deprecated": true
    },
    "saveLogsToDisk": {
      "description": "Whether each launch's log lines are kept on disk, so an earlier\nlaunch can be read after a restart. Absent means on.",
      "type": "boolean"
    },
    "updateCheckEnabled": {
      "description": "Whether Lanterna checks for newer releases. Absent means off.",
      "type": "boolean"
    },
    "hoverSelect": {
      "description": "Whether hovering a row moves the selection. Absent means off.",
      "type": "boolean"
    },
    "scrollSelect": {
      "description": "Whether scrolling moves the selection. Absent means off.",
      "type": "boolean"
    },
    "numberJump": {
      "description": "Whether holding Command or Option and pressing a row number jumps to\nthat row. Absent means off.",
      "type": "boolean"
    },
    "numberReorder": {
      "description": "Whether moving the selected row by key works in grouped lists.\nAbsent means off.",
      "type": "boolean"
    },
    "numberScope": {
      "description": "The rows row numbers cover. Absent means \"windows\".",
      "type": "string",
      "enum": [
        "windows",
        "allRows"
      ]
    },
    "hintsMode": {
      "description": "How the left edge of each row reads. Absent means \"prefix\".",
      "type": "string",
      "enum": [
        "prefix",
        "numbers",
        "neither"
      ]
    },
    "rowOrder": {
      "description": "Hand-arranged row orders by manual group. Entries that are invalid on\ntheir own are ignored one by one. Absent means no overrides.",
      "type": "integer"
    },
    "updateChannel": {
      "description": "The releases the check covers. Absent means \"stable\".",
      "type": "string",
      "enum": [
        "stable",
        "beta"
      ]
    },
    "exclusions": {
      "description": "Windows to keep out of the switcher list. Absent means no exclusions.\nElements that are invalid on their own are ignored one by one.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string"
          },
          "titlePattern": {
            "type": "string"
          }
        },
        "required": [
          "app",
          "titlePattern"
        ],
        "additionalProperties": false
      }
    },
    "keybindings": {
      "description": "User-configurable keybindings. Absent means all defaults.",
      "type": "object",
      "properties": {
        "show": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "showReverse": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "showFilter": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "next": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "previous": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "commit": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "cancel": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "toggleScope": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "deleteBackward": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "clearQuery": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "closeWindow": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "quitApplication": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "hideApplication": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "minimizeWindow": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "startFiltering": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "openSettings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "textScale": {
      "description": "The panel text and icon scale as a multiplier: one of the five steps.\nAbsent means 1.0 (the current size). The value allowlist lives in\nSwift, like the upper bound of `shortcutMemoryLength`.",
      "type": "number"
    },
    "panelWidth": {
      "description": "The panel width as a multiplier over the text-scaled width: one of\nthe allowed steps. Absent means 1.0 (the text-scaled width\nunchanged). The value allowlist lives in Swift, like `textScale`.",
      "type": "number"
    },
    "showDelayMs": {
      "description": "The panel show delay in milliseconds before the panel appears.\nAbsent or zero means off. Past 1000 clamps to it with a note, and\nanything else unreadable falls back to 150 with a note. The bounds\nlive in Swift, like `panelWidth`.",
      "type": "number"
    },
    "windowScope": {
      "description": "Every application's windows, or only those of the application in\nfront when the panel opens. Absent means \"allApps\".",
      "type": "string",
      "enum": [
        "allApps",
        "frontApp"
      ]
    },
    "displayTarget": {
      "description": "The menu-bar display, the cursor's display, the focused window's\ndisplay, or every display. Absent means \"primary\".",
      "type": "string",
      "enum": [
        "primary",
        "cursor",
        "frontWindow",
        "all"
      ]
    },
    "grouping": {
      "description": "One list, one group per Space with the shown Spaces first, or groups\nmade by assigning applications. Absent means \"none\".",
      "type": "string",
      "enum": [
        "none",
        "bySpace",
        "manual"
      ]
    },
    "otherSpacePlacement": {
      "description": "Where the windows-on-other-spaces section goes when grouped. Absent means \"endOfList\".\nIgnored when grouping by Space, which puts those windows in their own Space's group.",
      "type": "string",
      "enum": [
        "endOfList",
        "withinGroup"
      ]
    },
    "hiddenAppPlacement": {
      "description": "Where the hidden-apps section goes when grouped. Absent means \"endOfList\".",
      "type": "string",
      "enum": [
        "endOfList",
        "withinGroup"
      ]
    },
    "minimizedPlacement": {
      "description": "Where the minimized section goes when grouped. Absent means \"endOfList\".",
      "type": "string",
      "enum": [
        "endOfList",
        "withinGroup"
      ]
    },
    "fullscreenPlacement": {
      "description": "Where the fullscreen section goes when grouped. Absent means \"endOfList\".",
      "type": "string",
      "enum": [
        "endOfList",
        "withinGroup"
      ]
    },
    "windowlessAppPlacement": {
      "description": "Where the apps-without-windows section goes when grouped. Absent means \"endOfList\".\nGrouping by Space always puts it after the last group, since those apps are on no Space.",
      "type": "string",
      "enum": [
        "endOfList",
        "withinGroup"
      ]
    },
    "groupCount": {
      "description": "How many manual groups there are, 1 to 9. Absent means 1.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "groupHeadingStyle": {
      "description": "The group number, the name given to the group, or the names of the\napps in it. Absent means \"number\".",
      "type": "string",
      "enum": [
        "number",
        "name",
        "appNames"
      ]
    },
    "groupNames": {
      "description": "The names given to manual groups, keyed \"1\" to \"9\". Names for groups\npast the count are kept. Absent means no names.",
      "type": "object",
      "patternProperties": {
        "^[1-9]$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "groupAssignments": {
      "description": "Applications assigned to manual groups. Entries that are invalid on\ntheir own, or name an application an earlier entry named, are ignored\none by one. Absent means every application joins the first group.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bundleID": {
            "type": "string"
          },
          "group": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          }
        },
        "required": [
          "bundleID",
          "group"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
