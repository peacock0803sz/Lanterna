{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from ConfigSchema.pkl. Do not edit by hand.",
  "title": "Lanterna config",
  "description": "Settings vessel for Lanterna. Strict: unknown keys invalidate the whole file.",
  "type": "object",
  "properties": {
    "version": {
      "description": "Schema generation. Stays 1 for this revision.",
      "type": "integer"
    },
    "appearanceMode": {
      "description": "The appearance the panel and the guide windows use. Absent means \"system\".",
      "type": "string",
      "enum": [
        "system",
        "light",
        "dark"
      ]
    },
    "romajiScope": {
      "description": "The scope the romaji filter matches in. Absent means \"kanji\".",
      "type": "string",
      "enum": [
        "kana",
        "kanji"
      ]
    },
    "shortcutMemoryLength": {
      "description": "How many characters of a query the shortcut memory covers: a longer\nquery is neither recorded nor applied. 0 means off. Absent means 5.\nValues above 5 invalidate the whole file (mirrored by the Swift\nvalidation, which also enforces the upper bound).",
      "type": "integer",
      "minimum": 0
    },
    "fuzzyMatchEnabled": {
      "description": "Whether the filter also matches subsequence queries, not only\nsubstrings. Absent means on.",
      "type": "boolean"
    },
    "resultOrder": {
      "description": "The order the narrowed rows draw in. Absent means \"mru\".",
      "type": "string",
      "enum": [
        "mru",
        "score"
      ]
    },
    "otherSpaceMode": {
      "description": "Windows on other Spaces. Absent means \"show\".",
      "type": "string",
      "enum": [
        "show",
        "hide",
        "separateAtBottom"
      ]
    },
    "hiddenAppMode": {
      "description": "Windows of hidden applications. Absent means \"separateAtBottom\".",
      "type": "string",
      "enum": [
        "show",
        "hide",
        "separateAtBottom"
      ]
    },
    "minimizedMode": {
      "description": "Minimized windows. Absent means \"separateAtBottom\".",
      "type": "string",
      "enum": [
        "show",
        "hide",
        "separateAtBottom"
      ]
    },
    "fullscreenMode": {
      "description": "Native fullscreen windows. Absent means \"show\".",
      "type": "string",
      "enum": [
        "show",
        "hide",
        "separateAtBottom"
      ]
    },
    "sampleCount": {
      "description": "Fixture entries to show instead of live windows.\nAbsent means live windows. Must be zero or more when present.",
      "type": "integer",
      "minimum": 0
    },
    "stopMonitorEvery": {
      "description": "Intentional monitor stops, in whole seconds, so recovery can be watched.\nAbsent means an ordinary run. Must be one or more when present.",
      "type": "integer",
      "minimum": 1
    },
    "launchAtLogin": {
      "description": "Whether Lanterna starts at login. Absent means off.",
      "type": "boolean"
    },
    "logLevel": {
      "description": "Deprecated; ignored. Every level is recorded now, and the log window\nfilters what it shows. Any value is accepted so older files keep\ntheir other settings.",
      "deprecated": true
    },
    "saveLogsToDisk": {
      "description": "Whether each launch's log lines are kept on disk, so an earlier\nlaunch can be read after a restart. Absent means on.",
      "type": "boolean"
    },
    "updateCheckEnabled": {
      "description": "Whether Lanterna checks for newer releases. Absent means off.",
      "type": "boolean"
    },
    "updateChannel": {
      "description": "The releases the check covers. Absent means \"stable\".",
      "type": "string",
      "enum": [
        "stable",
        "beta"
      ]
    },
    "exclusions": {
      "description": "Windows to keep out of the switcher list. Absent means no exclusions.\nElements that are invalid on their own are ignored one by one.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string"
          },
          "titlePattern": {
            "type": "string"
          }
        },
        "required": [
          "app",
          "titlePattern"
        ],
        "additionalProperties": false
      }
    },
    "keybindings": {
      "description": "User-configurable keybindings. Absent means all defaults.",
      "type": "object",
      "properties": {
        "show": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "showReverse": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "showFilter": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "next": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "previous": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "commit": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "cancel": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "toggleScope": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "deleteBackward": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "clearQuery": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "closeWindow": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "quitApplication": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "hideApplication": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        },
        "minimizeWindow": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyCode": {
                "type": "integer"
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cmd",
                    "ctrl",
                    "opt",
                    "shift"
                  ]
                }
              }
            },
            "required": [
              "keyCode",
              "modifiers"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "textScale": {
      "description": "The panel text and icon scale as a multiplier: one of the five steps.\nAbsent means 1.0 (the current size). The value allowlist lives in\nSwift, like the upper bound of `shortcutMemoryLength`.",
      "type": "number"
    }
  },
  "additionalProperties": false
}
