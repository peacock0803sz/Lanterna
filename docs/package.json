{
  "name": "lanterna-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint:text": "textlint --config .textlintrc.en.json \"src/content/docs/en/**/*.md?(x)\" && textlint --config .textlintrc.ja.json \"src/content/docs/ja/**/*.md?(x)\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.13.6",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "textlint": "^15.8.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-terminology": "^5.2.16"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.4",
    "astro": "^7.3.5",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3"
  }
}
