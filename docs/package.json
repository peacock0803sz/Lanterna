{
  "name": "lanterna-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint:text": "textlint --config .textlintrc.en.json \"src/content/docs/en/**/*.md?(x)\" && textlint --config .textlintrc.ja.json \"src/content/docs/ja/**/*.md?(x)\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.9",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "textlint": "^16.1.3",
    "textlint-rule-preset-ja-technical-writing": "^12.1.0",
    "textlint-rule-terminology": "^5.2.16",
    "wrangler": "^4.168.0"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.4.13",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
