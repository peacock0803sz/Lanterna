  </svg>
  <Image
    src={switcherPanel}
    alt={alt}
    class="switcher"
    widths={[560, 1120]}
    sizes="39vw"
  />
</figure>

<style>
  .plate {
    position: relative;
    margin: 0;
    aspect-ratio: 1440 / 680;
    overflow: hidden;
    background-color: #1b2a40;
  }

  .plate :global(.photo) {
    position: absolute;
    left: -18.056%;
    top: -11.029%;
    width: 118.056%;
    height: 166.618%;
    max-width: none;
  }

  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      #0b152659 0%,
      #0b152614 55%,
      #0b152666 100%
    );
  }

  :global([data-theme="dark"]) .shade::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--ln-night-dim);
  }

  .overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .overlay :is(path, circle) {
    vector-effect: non-scaling-stroke;
  }

  .mono {
    font-family: var(--ln-font-mono);
  }

  .serif {
    font-family: var(--ln-font-serif);
  }

  .plate :global(.switcher) {
    position: absolute;
    left: 37.5%;
    top: 31.176%;
    width: 38.889%;
    height: auto;
    border-radius: clamp(4px, 0.7vw, 10px);
    box-shadow:
      0 4px 6px #00000014,
      0 24px 60px #0000004d;
  }

  @media (max-width: 50rem) {
    /* The overlay text scales with the plate and becomes illegible on phones. */
    .fine {
      display: none;
    }

    .plate :global(.switcher) {
      left: 26%;
      width: 60%;
      top: 22%;
    }
  }
</style>
