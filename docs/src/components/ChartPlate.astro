<figure class="plate">
  <Image
    src={lighthouse}
    alt=""
    class="photo"
    widths={[960, 1440, 1920]}
    sizes="118vw"
  />
  <div class="shade"></div>
  <svg class="overlay" viewBox="0 0 1440 680" aria-hidden="true">
    {arcs.map(({ x, y, opacity, d }) => (
      <path
        d={d}
        transform={`translate(${x} ${y})`}
        fill="#fff"
        fill-opacity={opacity}
      />
    ))}
    <g stroke="#fff" stroke-opacity="0.18" fill="none">
      <path d="M317 210L1617 -350" />
      <path d="M317 210L1617 590" />
    </g>
    <circle
      cx="317"
      cy="210"
      r="3.5"
      fill="none"
      stroke="#fff"
      stroke-opacity="0.8"
    />
    <g class="fine mono" font-size="11" letter-spacing="2">
      <text x="333" y="237" fill="#fff" fill-opacity="0.9">
        Fl ⌘⇥ 0.1s 0MB
      </text>
      <text x="333" y="255" fill="#fff" fill-opacity="0.5">
        LANTERNA LT.
      </text>
      <text x="72" y="641" fill="#fff" fill-opacity="0.7">
        FIG. 1 — ⌘ HELD, TAB × 2
      </text>
    </g>
    <g fill="#fff">
      <circle cx="43" cy="303" r="3" fill-opacity="0.33" />
      <circle cx="43" cy="323" r="3" />
      <circle cx="43" cy="343" r="3" fill-opacity="0.33" />
      <circle cx="43" cy="363" r="3" fill-opacity="0.33" />
    </g>
    <g
      class="fine serif"
      font-size="13"
      font-style="italic"
      fill="#fff"
      fill-opacity="0.4"
    >
      {soundings.map(([x, y, depth]) => (
        <text x={x} y={y + 13}>
          {depth}
        </text>
      ))}
    </g>
    <g stroke="#fff" stroke-opacity="0.7">
      <path d="M0 210.5h12" />
      <path d="M1428 210.5h12" />
    </g>
    <text
      class="fine mono"
      x="1370"
      y="228"
      font-size="10"
      letter-spacing="1"
      fill="#fff"
      fill-opacity="0.7"
    >
      57°45′N
    </text>
    <g
      class="compass"
      transform="translate(1166 464)"
      fill="none"
      stroke="#fff"
    >
      <circle cx="84" cy="84" r="63.5" stroke-opacity="0.5" />
      <circle cx="84" cy="84" r="51.5" stroke-opacity="0.35" />
      <path d={compassTicks} stroke-opacity="0.6" />
      <path d="M84 34l5 50-5 50-5-50z m-50 50l100 0" stroke-opacity="0.7" />
      <text
        class="serif"
        x="80"
        y="15"
        font-size="14"
        font-style="italic"
        fill="#fff"
        fill-opacity="0.85"
        stroke="none"
      >
        N
