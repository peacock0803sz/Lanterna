---
import Pagination from "./Pagination.astro";

const { editUrl, lastUpdated, entry } = Astro.locals.starlightRoute;
// The home page ends with its legend; the site footer follows directly.
const isHome = Boolean(entry.data.hero);
---

{!isHome && (
  <footer>
    <Pagination />
    {(editUrl || lastUpdated) && (
      <div class="meta">
        {editUrl && (
          <a href={editUrl} class="print:hidden">
            Edit this page on GitHub ↗
          </a>
        )}
        {lastUpdated && (
          <p>
            Last corrected{" "}
            <time datetime={lastUpdated.toISOString()}>
              {lastUpdated.toISOString().slice(0, 10)}
            </time>
          </p>
        )}
      </div>
    )}
  </footer>
)}

<style>
  footer {
    display: flex;
    flex-direction: column;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 3rem;
    padding-top: 28px;
    font-family: var(--ln-font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ln-muted);
  }

  .meta p {
    margin: 0 0 0 auto;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--ln-ink);
  }
</style>
