---
import Search from "@astrojs/starlight/components/Search.astro";
import { Image } from "astro:assets";
import appIcon from "../assets/app-icon.png";
import LanguageSelect from "./LanguageSelect.astro";
import LucideIcon from "./LucideIcon.astro";
import VersionSelect from "./VersionSelect.astro";
import ThemeSelect from "./ThemeSelect.astro";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="header">
  <div class="brand">
    <a href={siteTitleHref} class="site-title">
      <Image src={appIcon} alt="" width={30} height={30} class="logo" />
      <span translate="no">{siteTitle}</span>
    </a>
    <VersionSelect />
  </div>
  <div class="search print:hidden">
    <Search />
  </div>
  <div class="tools print:hidden">
    <a
      href="https://github.com/peacock0803sz/Lanterna"
      class="github"
      aria-label="GitHub"
    >
      <LucideIcon name="github" size={17} />
    </a>
    <LanguageSelect />
    <ThemeSelect />
  </div>
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-inline-end: auto;
  }

  .site-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--ln-font-serif);
    font-size: 24px;
    font-weight: 500;
    color: var(--ln-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-title :global(.logo) {
    width: 30px;
    height: 30px;
    border-radius: 7px;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .github {
    display: flex;
    color: var(--ln-muted);
  }

  .github:hover {
    color: var(--ln-ink);
  }

  /* On phones, sheet pages carry these in the menu instead; the menu button sits where they would be. */
  @media (max-width: 49.99rem) {
    :global([data-has-sidebar]) .tools {
      display: none;
    }
  }

  @media (min-width: 50rem) {
    .header {
      display: grid;
      grid-template-columns: 1fr minmax(0, 21.25rem) 1fr;
      gap: 1.5rem;
    }

    .brand {
      margin-inline-end: 0;
    }

    .search {
      display: flex;
    }

    .tools {
      justify-self: end;
    }
  }
</style>
