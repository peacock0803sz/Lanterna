---
// Mirrors the `locales` option in astro.config.mjs; overrides cannot read the
// Starlight user config with types.
const locales = [
  { code: "en", label: "EN" },
  { code: "ja", label: "日本語" },
];

const current = Astro.locals.starlightRoute.locale ?? "en";
// `Astro.url.pathname` includes the configured `base` (e.g. `/v0.8.4/en/`),
// so swap only the locale segment that follows the base prefix.
const base = import.meta.env.BASE_URL;
const prefix = base === "/" ? "" : base.replace(/\/$/, "");
const links = locales.map(({ code, label }) => {
  const suffix = Astro.url.pathname.slice(prefix.length);
  const swapped =
    suffix === `/${current}` || suffix.startsWith(`/${current}/`)
      ? `/${code}${suffix.slice(current.length + 1)}`
      : suffix;
  return {
    code,
    label,
    href: `${prefix}${swapped}`,
    isCurrent: code === current,
  };
});
---

<nav
  class="locales"
  aria-label={Astro.locals.t("languageSelect.accessibleLabel")}
>
  {links.map(({ code, label, href, isCurrent }, index) => (
    <>
      {index > 0 && <span aria-hidden="true">/</span>}
      <a
        href={href}
        hreflang={code}
        lang={code}
        aria-current={isCurrent ? "true" : undefined}
      >
        {label}
      </a>
    </>
  ))}
</nav>

<style>
  .locales {
    display: flex;
    gap: 0.6em;
    font-family: var(--ln-font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--ln-muted);
    white-space: nowrap;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover,
  a[aria-current] {
    color: var(--ln-ink);
  }
</style>
