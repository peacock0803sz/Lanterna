---
import LucideIcon from "./LucideIcon.astro";

interface Link {
  key: string;
  label: string;
  href: string;
  /** The shortened URL shown at the end of the row. */
  display: string;
}

interface Props {
  links: Link[];
}

const { links } = Astro.props;
---

<ul class="link-list not-content">
  {links.map(({ key, label, href, display }) => (
    <li>
      <a href={href}>
        <span class="key">{key}</span>
        <span class="label">{label}</span>
        <span class="url">{display}</span>
        <LucideIcon name="arrow-up-right" size={16} class="arrow" />
      </a>
    </li>
  ))}
</ul>

<style>
  .link-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--ln-ink);
  }

  li + li {
    border-top: 1px solid var(--ln-hairline);
  }

  a {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 18px 0;
    text-decoration: none;
    color: var(--ln-ink);
  }

  a:hover .label {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .key {
    flex: 0 0 180px;
    font-family: var(--ln-font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ln-muted);
  }

  .label {
    flex: 1;
    font-size: 16px;
    font-weight: 500;
  }

  .url {
    font-family: var(--ln-font-mono);
    font-size: 12px;
    color: var(--ln-muted);
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .key {
      flex-basis: 7rem;
    }
    .url {
      display: none;
    }
  }
</style>
