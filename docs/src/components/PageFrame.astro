---
// Based on Starlight's PageFrame. Adds the chart border under the header on
// sheet pages and a full-width site footer below the main frame.
import MobileMenuToggle from "@astrojs/starlight/components/MobileMenuToggle.astro";
import ChartBorder from "./ChartBorder.astro";
import SiteFooter from "./SiteFooter.astro";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
  <header class="header">
    <div class="header-bar">
      <slot name="header" />
    </div>
    {hasSidebar && <ChartBorder position="top" class="header-border" />}
  </header>
  {hasSidebar && (
    <nav
      class="sidebar print:hidden"
      aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
    >
      <MobileMenuToggle />
      <script>
        // The mobile menu uses the popover API to open and close without JavaScript. We enhance this
        // behaviour with focus trapping while the menu is open.
        class StarlightSidebarPane extends HTMLElement {
          constructor() {
            super();

            const desktopMediaQuery = matchMedia("(min-width: 50em)");

            // Remove the popover attribute on desktop viewports. It's only needed for the mobile menu.
            const resetPopoverAttribute = () => {
              this.popover = desktopMediaQuery.matches ? null : "auto";
            };
            resetPopoverAttribute();
            desktopMediaQuery.addEventListener("change", () =>
              resetPopoverAttribute(),
            );

            // Update the menu state when the sidebar popover is toggled.
            this.addEventListener("toggle", ({ newState }) =>
              this.trapFocus(newState === "open"),
            );
          }
          /** Trap keyboard focus inside the header and menu when the menu is expanded. */
          trapFocus(shouldTrap: boolean) {
            document
              .querySelectorAll<HTMLElement>(".main-frame, .sl-skip-link")
              .forEach((el) => {
                el.toggleAttribute("inert", shouldTrap);
              });
          }
        }
        customElements.define("sl-sidebar-pane", StarlightSidebarPane);
      </script>
      <sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
        <div class="sidebar-content sl-flex">
          <slot name="sidebar" />
        </div>
      </sl-sidebar-pane>
    </nav>
  )}
  <div class="main-frame">
    <slot />
  </div>
  <SiteFooter />
</div>

<style>
  .page {
    flex-direction: column;
    min-height: 100vh;
  }

  .header {
    z-index: var(--sl-z-index-navbar);
    position: fixed;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 100%;
    height: var(--sl-nav-height);
    background-color: var(--sl-color-bg-nav);
  }

  .header-bar {
    height: var(--ln-nav-bar-height);
    padding: 0 var(--sl-nav-pad-x);
  }

  :global([data-has-sidebar]) .header-bar {
    padding-inline-end: calc(
      var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
    );
  }

  .header-border {
    display: none;
  }

  .sidebar-pane {
    /* By default, user agents apply some opinionated styles to popovers, which we don’t want. */
    border: unset;
    padding: unset;
    height: unset;
    color: unset;

    position: fixed;
    z-index: var(--sl-z-index-menu);
    inset-block: var(--sl-nav-height) 0;
    inset-inline-start: 0;
    width: 100%;
    background-color: var(--sl-color-bg-sidebar);
    overflow-y: auto;
    scrollbar-gutter: stable;
  }

  .sidebar-content {
    height: 100%;
    min-height: max-content;
    padding: 1.5rem var(--sl-sidebar-pad-x) 0;
    flex-direction: column;
    gap: 1rem;
  }

  .main-frame {
    flex-grow: 1;
    padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
    padding-inline-start: var(--sl-content-inline-start);
  }

  @media (min-width: 50rem) {
    :global([data-has-sidebar]) .header-bar {
      padding-inline-end: var(--sl-nav-pad-x);
    }
    .header-border {
      display: block;
    }
    .sidebar-pane {
      /* Make the sidebar visible on larger screens instead of deferring to popover state. */
      display: block;
      width: var(--sl-sidebar-width);
    }
    .sidebar-content {
      padding-top: 4rem;
      padding-inline-end: 0;
    }
  }
</style>
