---
// Based on Starlight's PageFrame. Adds the chart border under the header on
// sheet pages, the edition notice under the header bar, and a full-width site
// footer below the main frame. The sidebar shows from tablet width up; phones
// reach the sheets through the menu in the header instead.
import ChartBorder from "./ChartBorder.astro";
import NoticeBanner from "./NoticeBanner.astro";
import SiteFooter from "./SiteFooter.astro";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
  <header class="header">
    <div class="header-bar">
      <slot name="header" />
    </div>
    <NoticeBanner />
    {hasSidebar && <ChartBorder position="top" />}
  </header>
  {hasSidebar && (
    <nav
      class="sidebar print:hidden"
      aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
    >
      <div id="starlight__sidebar" class="sidebar-pane">
        <div class="sidebar-content sl-flex">
          <slot name="sidebar" />
        </div>
      </div>
    </nav>
  )}
  <div class="main-frame">
    <slot />
  </div>
  <SiteFooter />
</div>

<style>
  .page {
    flex-direction: column;
    min-height: 100vh;
  }

  .header {
    z-index: var(--sl-z-index-navbar);
    position: fixed;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 100%;
    height: var(--sl-nav-height);
    background-color: var(--sl-color-bg-nav);
  }

  .header-bar {
    /* Keeps the edition menu above the notice and the chart border. */
    position: relative;
    z-index: 1;
    height: var(--ln-nav-bar-height);
    padding: 0 var(--sl-nav-pad-x);
  }

  .sidebar {
    display: none;
  }

  .sidebar-pane {
    position: fixed;
    z-index: var(--sl-z-index-menu);
    inset-block: var(--sl-nav-height) 0;
    inset-inline-start: 0;
    width: var(--sl-sidebar-width);
    background-color: var(--sl-color-bg-sidebar);
    overflow-y: auto;
    scrollbar-gutter: stable;
  }

  .sidebar-content {
    height: 100%;
    min-height: max-content;
    padding: 4rem 0 0 var(--sl-sidebar-pad-x);
    flex-direction: column;
    gap: 1rem;
  }

  .main-frame {
    flex-grow: 1;
    padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
    padding-inline-start: var(--sl-content-inline-start);
  }

  @media (min-width: 50rem) {
    .sidebar {
      display: block;
    }
  }
</style>
