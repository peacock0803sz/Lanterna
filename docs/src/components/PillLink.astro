---
import LucideIcon from "./LucideIcon.astro";

interface Props {
  href: string;
}

const { href } = Astro.props;
---

{/* A div, not a p: MDX wraps the label in its own paragraph. */}
<div class="pill-wrap not-content">
  <a href={href} class="pill">
    <slot />
    <LucideIcon name="arrow-up-right" size={16} />
  </a>
</div>

<style>
  .pill-wrap {
    padding-top: 24px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 22px;
    border: 1px solid var(--ln-ink);
    border-radius: 9999px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ln-ink);
    text-decoration: none;
  }

  .pill :global(p) {
    margin: 0;
  }

  .pill:hover {
    background-color: var(--ln-hairline);
  }
</style>
