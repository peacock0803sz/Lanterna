---
// Based on Starlight's TwoColumnContent. On wide screens the table of contents
// becomes a sticky column at the right edge, inside the chart's gutter, instead
// of a fixed pane, and the article widens to fill the space between.
---

<div class="two-column">
  {Astro.locals.starlightRoute.toc && (
    <aside class="right-sidebar-container print:hidden">
      <div class="right-sidebar">
        <slot name="right-sidebar" />
      </div>
    </aside>
  )}
  <div class="main-pane">
    <slot />
  </div>
</div>

<style>
  .main-pane {
    isolation: isolate;
  }

  @media (min-width: 72rem) {
    :global([data-has-toc]) .two-column {
      display: flex;
      align-items: flex-start;
      gap: var(--ln-column-gap);
      padding-inline-end: var(--sl-nav-pad-x);
    }

    .right-sidebar-container {
      order: 2;
      flex: 0 0 var(--ln-toc-width);
      position: sticky;
      top: var(--sl-nav-height);
    }

    .right-sidebar {
      max-height: calc(100vh - var(--sl-nav-height));
      overflow-y: auto;
      scrollbar-width: none;
    }

    /* The article takes the width the TOC leaves, so the TOC sits at the right edge. */
    .main-pane {
      order: 1;
      flex: 1 1 var(--sl-content-width);
      min-width: 0;
    }

    :global([data-has-toc]) .main-pane :global(.sl-container) {
      max-width: none;
    }
  }
</style>
